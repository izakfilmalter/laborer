SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Dedicated production-runtime canary app. Never reuse production credentials.
LABORER_ACP_CANARY_SLACK_APP_TOKEN=
LABORER_ACP_CANARY_SLACK_BOT_TOKEN=

# Dedicated Chat SDK walking-skeleton canary app.
LABORER_CHAT_CANARY_SLACK_APP_TOKEN=
LABORER_CHAT_CANARY_SLACK_BOT_TOKEN=

# For multiple workspaces, replace SLACK_BOT_TOKEN with one referenced variable
# per installation and set LABORER_SLACK_WORKSPACES to a one-line JSON array:
# LABORER_SLACK_WORKSPACES=[{"teamId":"TFIRST","botTokenEnvironment":"SLACK_BOT_TOKEN_FIRST","root":"/existing/laborer/root"},{"teamId":"TSECOND","botTokenEnvironment":"SLACK_BOT_TOKEN_SECOND","root":"/existing/other/root"}]
# SLACK_BOT_TOKEN_FIRST=
# SLACK_BOT_TOKEN_SECOND=

# Desktop and web development defaults. scripts/worktree-setup.sh appends
# worktree-specific overrides to the copied root .env.local.
PORT=2100
LABORER_DAEMON_PORT=2100
VITE_PORT=2101
TERMINAL_PORT=2102
PORT_RANGE_START=2200
PORT_RANGE_END=2209
VITE_SERVER_URL=http://localhost:2100
VITE_SERVER_PORT=2100
VITE_TERMINAL_PORT=2102

# Populated by scripts/worktree-setup.sh for generated worktrees.
WORKTREE_SLUG=
WORKTREE_INDEX=
