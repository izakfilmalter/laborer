{
  "name": "laborer",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/atom-react": "4.0.0-beta.46",
      "@effect/cli": "0.72.1",
      "@effect/cluster": "0.55.0",
      "@effect/experimental": "0.57.11",
      "@effect/opentelemetry": "0.59.3",
      "@effect/platform-browser": "0.73.0",
      "@effect/platform-node": "4.0.0-beta.46",
      "@effect/platform": "0.93.8",
      "@effect/printer-ansi": "0.47.0",
      "@effect/printer": "0.47.0",
      "@effect/rpc": "0.72.2",
      "@effect/sql": "0.48.6",
      "@effect/typeclass": "0.38.0",
      "@effect/vitest": "0.27.0",
      "@effect/workflow": "0.15.2",
      "@types/react-dom": "^19.2.3",
      "@types/react": "^19.2.14",
      "dotenv": "^17.4.1",
      "effect": "4.0.0-beta.46",
      "lucide-react": "1.8.0",
      "next-themes": "0.4.6",
      "react-dom": "^19.2.5",
      "react": "^19.2.5",
      "typescript": "^6.0.2",
      "zod": "^4.3.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@laborer/server --filter=@laborer/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck --ui=stream",
    "dev:desktop": "turbo run dev --filter=@laborer/server --filter=@laborer/web --filter=@laborer/desktop",
    "dev:native": "turbo -F native dev",
    "build:app": "tsx scripts/build-desktop-artifact.ts",
    "start:desktop": "turbo run start --filter=@laborer/desktop",
    "test": "turbo test --ui=stream --concurrency=3",
    "test:watch": "turbo test:watch --ui=stream --concurrency=3",
    "check": "turbo run //#format:fix typecheck test --ui=stream --concurrency=3",
    "dist:desktop:dmg": "tsx scripts/build-desktop-artifact.ts",
    "dist:desktop:artifact": "tsx scripts/build-desktop-artifact.ts",
    "format": "ultracite check",
    "format:fix": "ultracite fix",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@github/alive-client": "^1.2.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@effect/language-service": "^0.85.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "ultracite": "7.4.4",
    "vite": "^8.0.8"
  },
  "packageManager": "bun@1.3.5",
  "overrides": {
    "effect": "4.0.0-beta.46",
    "@effect/cli": "0.72.1",
    "@effect/cluster": "0.55.0",
    "@effect/experimental": "0.57.11",
    "@effect/opentelemetry": "0.59.3",
    "@effect/platform": "0.93.8",
    "@effect/platform-browser": "0.73.0",
    "@effect/platform-node": "4.0.0-beta.46",
    "@effect/printer": "0.47.0",
    "@effect/printer-ansi": "0.47.0",
    "@effect/rpc": "0.72.2",
    "@effect/sql": "0.48.6",
    "@effect/typeclass": "0.38.0",
    "@effect/workflow": "0.15.2"
  },
  "patchedDependencies": {}
}
