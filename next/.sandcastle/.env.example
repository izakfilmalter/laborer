# Dedicated read-only GitHub token used inside agent sandboxes. Do not use the
# runner's write-capable token here. Fine-grained permissions: Actions (read),
# Contents (read), Issues (read), Metadata (read), and Pull requests (read).
SANDCASTLE_AGENT_GH_TOKEN=

# The host runner uses the existing `gh auth` login for issue comments, pushes,
# PR creation, and merges. Those write credentials are not injected into agents.

# Optional. Defaults to the repository's default branch.
SANDCASTLE_BASE_BRANCH=

# Publish reviewed branches as PRs and merge them after GitHub checks pass.
SANDCASTLE_AUTO_MERGE=true
SANDCASTLE_WAIT_FOR_MERGES=true
SANDCASTLE_MAX_ITERATIONS=10
SANDCASTLE_MAX_PARALLEL=4
SANDCASTLE_REPAIR_FAILED_CHECKS=true
SANDCASTLE_MAX_REPAIR_ATTEMPTS=3
SANDCASTLE_MAX_LOCAL_GATE_REPAIR_ATTEMPTS=2
SANDCASTLE_CHECK_TIMEOUT_MS=1200000
SANDCASTLE_CHECK_POLL_INTERVAL_MS=30000
SANDCASTLE_MERGE_TIMEOUT_MS=1200000
SANDCASTLE_HOST_COMMAND_TIMEOUT_MS=120000
SANDCASTLE_SANDBOX_COMMAND_TIMEOUT_SECONDS=1200
SANDCASTLE_AGENT_RUN_TIMEOUT_MS=14400000

# Build with `bun run sandcastle:build-image` before the first run.
SANDCASTLE_IMAGE_NAME=sandcastle:laborer-next

# Dedicated OpenCode credentials for trusted Sandcastle agents. Create minimal
# files containing only the provider accounts these agents need; do not point
# these at the host's general-purpose OpenCode stores.
SANDCASTLE_OPENCODE_AUTH_FILE=.sandcastle/opencode-auth.json
SANDCASTLE_OPENCODE_ACCOUNT_FILE=.sandcastle/opencode-account.json

# Agents use the minimal `.sandcastle/opencode.json` plus the dedicated files
# above. The runner copies credentials into private, per-sandbox writable
# directories so OAuth refresh cannot mutate the source files.
# The all-around phases use openai/gpt-5.6-sol medium; UI phases use
# anthropic/claude-opus-5 medium.
