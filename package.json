{
  "name": "laborer",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "effect": "4.0.0-rc.109",
      "@effect/atom-react": "4.0.0-rc.109",
      "@effect/platform-bun": "4.0.0-rc.109",
      "@effect/platform-node": "4.0.0-rc.109",
      "@effect/sql-sqlite-bun": "4.0.0-rc.109",
      "@effect/sql-sqlite-node": "4.0.0-rc.109",
      "@effect/vitest": "4.0.0-rc.109",
      "ioredis": "^5.7.0",
      "typescript": "^5",
      "zod": "^4.1.13"
    }
  },
  "type": "module",
  "scripts": {
    "sandcastle": "bun .sandcastle/main.ts",
    "dev": "bun scripts/dev-runner.ts",
    "dev:desktop": "bun scripts/dev-runner.ts --desktop",
    "dev:bot": "bun run --cwd apps/bot dev:slack",
    "start:bot": "bun run --cwd apps/bot start:slack",
    "build": "turbo build",
    "typecheck": "turbo typecheck --ui=stream",
    "build:app": "tsx scripts/build-desktop-artifact.ts",
    "test": "bun test scripts/dev-runner.test.ts && turbo test --ui=stream --concurrency=3",
    "test:ci": "bun test scripts/dev-runner.test.ts && turbo test --ui=stream --concurrency=1",
    "test:watch": "turbo test:watch --ui=stream --concurrency=3",
    "check": "turbo run //#format:fix typecheck test --ui=stream --concurrency=3 && bun run --cwd apps/bot check:secrets && bun run --cwd apps/bot test:acp-compatibility",
    "check:secrets": "bun run --cwd apps/bot check:secrets",
    "test:acp-compatibility": "bun run --cwd apps/bot test:acp-compatibility",
    "verify:runtimes": "bun run --cwd apps/bot verify:runtimes",
    "dist:desktop:dmg": "tsx scripts/build-desktop-artifact.ts",
    "dist:desktop:artifact": "tsx scripts/build-desktop-artifact.ts",
    "format": "ultracite check apps packages scripts package.json tsconfig.json turbo.json biome.json",
    "format:fix": "ultracite fix apps packages scripts package.json tsconfig.json turbo.json biome.json",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@laborer/env": "workspace:*",
    "@laborer/ensure": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@biomejs/biome": "2.4.0",
    "@effect/language-service": "0.87.2",
    "@laborer/config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.2.4",
    "vite": "^6.2.2"
  },
  "packageManager": "bun@1.3.5",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.109"
  },
  "patchedDependencies": {}
}
