{
  "name": "@laborer/slack-runtime",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/main.js",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": "24.11.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.99"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "sandcastle": "bun run --cwd ../.sandcastle start",
    "companion:build": "electron-vite build",
    "companion:acceptance:macos": "sh tests/macos-launch-agent-acceptance.sh",
    "companion:dev": "bun run companion:prepare && electron-vite dev",
    "companion:package:macos": "bun run companion:prepare && bun run companion:build && node src/companion/package-macos.ts",
    "companion:prepare": "node -e \"require('electron')\"",
    "dev:slack": "node --watch --env-file-if-exists=.env.local src/acp-runtime/production-live.ts",
    "start:acp-canary": "node --env-file-if-exists=.env.local src/acp-runtime/live.ts",
    "start:chat-canary": "node --env-file-if-exists=.env.local src/chat-plane/live.ts",
    "start:slack": "node --env-file-if-exists=.env.local src/acp-runtime/production-live.ts",
    "check:secrets": "vitest run tests/secret-safety.test.ts",
    "test": "vitest run --exclude tests/opencode-permission-policy.test.ts --exclude tests/opencode-acp-compatibility.test.ts",
    "test:acp-compatibility": "vitest run tests/opencode-acp-compatibility.test.ts tests/opencode-permission-policy.test.ts --maxWorkers=1",
    "test:opencode-permissions": "vitest run tests/opencode-permission-policy.test.ts --maxWorkers=1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.companion.json",
    "verify:runtimes": "node tests/support/verify-runtime-versions.ts && bun tests/support/verify-runtime-versions.ts",
    "format": "ultracite check",
    "format:fix": "ultracite fix",
    "check": "bun run typecheck && bun run format && bun run test && bun run test:acp-compatibility"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@base-ui/react": "1.6.0",
    "@chat-adapter/slack": "4.37.0",
    "@effect/platform-bun": "4.0.0-beta.99",
    "@effect/platform-node": "4.0.0-beta.99",
    "@effect/sql-sqlite-bun": "4.0.0-beta.99",
    "@effect/sql-sqlite-node": "4.0.0-beta.99",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opencode-ai/client": "0.0.0-next-17074",
    "@slack/web-api": "8.0.0",
    "@tanstack/react-router": "1.170.18",
    "chat": "4.37.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-beta.99",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@effect/language-service": "^0.87.0",
    "@effect/vitest": "4.0.0-beta.99",
    "@opencode-ai/cli": "0.0.0-next-17074",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "^17.4.2",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "ultracite": "7.2.4",
    "vite": "7.3.6",
    "vitest": "^4.0.17"
  },
  "trustedDependencies": [
    "@opencode-ai/cli"
  ]
}
