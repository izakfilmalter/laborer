# GitHub token placed in the environment of agent processes. A fine-grained,
# read-only token (Contents, Issues, Metadata, and Pull requests) reduces
# accidental writes, but is not a security boundary in host mode.
SANDCASTLE_AGENT_GH_TOKEN=

# WARNING: Agents are trusted, unattended host processes with auto-approved
# OpenCode permissions. They inherit the host environment and can read the host
# filesystem, OpenCode config/state, normal `gh` config, SSH keys, and other
# repositories. They can unset GH_TOKEN and use reachable host credentials.
# Git worktrees isolate branches only; they do not contain processes or secrets.
# Four workers may also consume substantial workstation CPU and memory.
#
# The runner uses the existing `gh auth` login for comments, pushes, PR creation,
# and merges. Configure and authenticate the machine's `opencode2` normally;
# Sandcastle uses that executable and all of its existing configuration directly.

# Optional. Defaults to the repository's default branch.
SANDCASTLE_BASE_BRANCH=

# Publish branches as PRs and merge them after Sandcastle review and verification.
SANDCASTLE_AUTO_MERGE=true
SANDCASTLE_WAIT_FOR_MERGES=true
SANDCASTLE_MAX_ITERATIONS=10
SANDCASTLE_MAX_PARALLEL=4
SANDCASTLE_MAX_REPAIR_ATTEMPTS=3
SANDCASTLE_OPENCODE_MAX_ATTEMPTS=3
SANDCASTLE_OPENCODE_RETRY_DELAY_SECONDS=15
SANDCASTLE_GITHUB_POLL_INTERVAL_MS=30000
SANDCASTLE_MERGE_TIMEOUT_MS=1200000
SANDCASTLE_HOST_COMMAND_TIMEOUT_MS=120000
SANDCASTLE_SANDBOX_COMMAND_TIMEOUT_SECONDS=1200
SANDCASTLE_AGENT_RUN_TIMEOUT_MS=14400000
SANDCASTLE_AGENT_IDLE_TIMEOUT_SECONDS=1800
SANDCASTLE_PR_HEAD_OBSERVATION_TIMEOUT_MS=120000

# Host prerequisites: Bun 1.3.5, Node 24.11.1, Git, authenticated `gh`, jq,
# Xcode Command Line Tools (or an equivalent compiler toolchain), and an
# authenticated machine-installed opencode2. Provider/plugin setup, including
# any local Anthropic plugin build, is the same setup used by direct opencode2
# runs. Docker and sqlite3 are not required.
# The all-around phases use openai/gpt-5.6-sol-fast medium; UI phases use
# anthropic/claude-opus-5 medium.
