{
  "name": "@laborer/slack-tracer-prototype",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/main.js",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": "24.11.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.99"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "sandcastle": "tsx .sandcastle/main.ts",
    "sandcastle:build-image": "sandcastle docker build-image --image-name sandcastle:laborer-next --dockerfile .sandcastle/Dockerfile",
    "prototype": "bun run src/prototype/demo.ts",
    "companion:build": "electron-vite build",
    "companion:acceptance:macos": "sh tests/macos-launch-agent-acceptance.sh",
    "companion:dev": "electron-vite dev",
    "companion:package:macos": "bun run companion:build && node src/companion/package-macos.ts",
    "recovery": "bun run src/recovery-cli.ts",
    "dev:slack": "node --env-file-if-exists=.env.local src/development-daemon/dev.ts",
    "start:acp-canary": "node --env-file-if-exists=.env.local src/acp-conversation-prototype/live.ts",
    "start:slack": "node --env-file-if-exists=.env.local src/slack/live.ts",
    "slack:oauth-callback:start": "node scripts/slack-oauth-callback.mjs start",
    "slack:oauth-callback:stop": "node scripts/slack-oauth-callback.mjs stop",
    "slack:funnel": "bun run src/slack-funnel.ts",
    "slack:funnel:off": "bun run src/slack-funnel.ts off",
    "slack:funnel:on": "bun run src/slack-funnel.ts on",
    "slack:funnel:status": "bun run src/slack-funnel.ts status",
    "check:secrets": "vitest run tests/secret-safety.test.ts",
    "test": "vitest run --exclude tests/opencode-permission-policy.test.ts --exclude tests/opencode-acp-compatibility.test.ts",
    "test:acp-compatibility": "vitest run tests/opencode-acp-compatibility.test.ts tests/opencode-permission-policy.test.ts --maxWorkers=1",
    "test:opencode-permissions": "vitest run tests/opencode-permission-policy.test.ts --maxWorkers=1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.companion.json",
    "verify:runtimes": "node tests/support/verify-runtime-versions.ts && bun tests/support/verify-runtime-versions.ts",
    "format": "ultracite check",
    "format:fix": "ultracite fix",
    "check": "bun run typecheck && bun run format && bun run test && bun run test:acp-compatibility"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@base-ui/react": "1.6.0",
    "@effect/platform-bun": "4.0.0-beta.99",
    "@effect/platform-node": "4.0.0-beta.99",
    "@effect/sql-sqlite-bun": "4.0.0-beta.99",
    "@effect/sql-sqlite-node": "4.0.0-beta.99",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opencode-ai/sdk": "1.18.4",
    "@slack/socket-mode": "3.0.0",
    "@slack/web-api": "8.0.0",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-beta.99",
    "emulate": "0.9.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@biomejs/biome": "2.4.0",
    "@effect/language-service": "^0.87.0",
    "@effect/vitest": "4.0.0-beta.99",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "^17.4.2",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.0",
    "opencode-ai": "1.18.4",
    "tsx": "^4.22.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "ultracite": "7.2.4",
    "vite": "7.3.6",
    "vitest": "^4.0.17"
  }
}
