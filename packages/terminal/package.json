{
  "name": "@laborer/terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env.local --",
    "dev": "tsdown --watch",
    "build": "tsdown && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": "./src/utility-main.ts",
    "./rpc/handlers": "./src/rpc/handlers.ts",
    "./services/pty-direct": "./src/services/pty-direct.ts",
    "./services/pty-host-proxy": "./src/services/pty-host-proxy.ts",
    "./services/pty-host-paths": "./src/services/pty-host-paths.ts",
    "./services/terminal-session-persistence-layer": "./src/services/terminal-session-persistence-layer.ts",
    "./services/terminal-manager": "./src/services/terminal-manager.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@laborer/ensure": "workspace:*",
    "@laborer/env": "workspace:*",
    "@laborer/shared": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "effect": "catalog:",
    "ioredis": "catalog:",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@laborer/config": "workspace:*",
    "@types/node": "^25.3.3",
    "tsdown": "^0.20.3",
    "tsx": "^4.19.4",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  }
}
