# Dedicated read-only GitHub token used inside agent sandboxes. Do not use the
# runner's write-capable token here. Fine-grained permissions: Contents (read),
# Issues (read), Metadata (read), and Pull requests (read).
SANDCASTLE_AGENT_GH_TOKEN=

# The host runner uses the existing `gh auth` login for issue comments, pushes,
# PR creation, and merges. Those write credentials are not injected into agents.

# Optional. Defaults to the repository's default branch.
SANDCASTLE_BASE_BRANCH=

# Publish branches as PRs and merge them after Sandcastle review and verification.
SANDCASTLE_AUTO_MERGE=true
SANDCASTLE_WAIT_FOR_MERGES=true
SANDCASTLE_MAX_ITERATIONS=10
SANDCASTLE_MAX_PARALLEL=4
SANDCASTLE_MAX_REPAIR_ATTEMPTS=3
SANDCASTLE_GITHUB_POLL_INTERVAL_MS=30000
SANDCASTLE_MERGE_TIMEOUT_MS=1200000
SANDCASTLE_HOST_COMMAND_TIMEOUT_MS=120000
SANDCASTLE_SANDBOX_COMMAND_TIMEOUT_SECONDS=1200
SANDCASTLE_AGENT_RUN_TIMEOUT_MS=14400000
SANDCASTLE_AGENT_IDLE_TIMEOUT_SECONDS=1800
SANDCASTLE_PR_HEAD_OBSERVATION_TIMEOUT_MS=120000

# Build with `bun run sandcastle:build-image` before the first run.
SANDCASTLE_IMAGE_NAME=sandcastle:laborer

# Agents use the machine-managed OpenCode configuration and credentials mounted
# read-only from ~/.config/opencode and ~/.local/share/opencode. Run OpenCode's
# provider login commands on the host to add or refresh those credentials.
# Optional path to the local V2 Anthropic auth plugin checkout. Defaults to the
# opencode-anthropic-auth repository beside Laborer.
SANDCASTLE_OPENCODE_ANTHROPIC_PLUGIN_PATH=
# The all-around phases use openai/gpt-5.6-sol-fast medium; UI phases use
# anthropic/claude-opus-5 medium.
